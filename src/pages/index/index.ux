<template>
  <div class="container">
    <div class="header-zone">
      <text class="app-title">БУФЕР ОБМЕНА</text>
      <div class="status-badge">
        <text class="status-text">{{ hasData ? 'ОФЛАЙН ПАМЯТЬ' : 'ЭКО РЕЖИМ' }}</text>
      </div>
    </div>

    <div if="{{ !hasData }}" class="screen-layout">
      <div class="code-box">
        <text class="code-title">КОД ПОДКЛЮЧЕНИЯ</text>
        <text class="code-number">77777</text>
      </div>
      <div class="info-box">
        <text class="hint-text">Введите этот код на сайте</text>
        <text class="sub-hint-text">Прикрепите текстовый файл .txt</text>
      </div>
      <input type="button" class="btn btn-primary" value="Загрузить шпору" onclick="checkServerData" />
    </div>

    <div if="{{ hasData }}" class="screen-layout">
      <div class="text-card">
        <text class="main-text">{{ savedText }}</text>
      </div>
      <input type="button" class="btn btn-danger" value="Стереть текст" onclick="clearData" />
    </div>

    <div class="footer-credits">
      <text class="credits-label">РАЗРАБОТЧИК</text>
      <text class="credits-name">A. SOLDATOV</text>
    </div>
  </div>
</template>

<style>
  .container { flex-direction: column; align-items: center; width: 212px; height: 490px; background-color: #000000; padding-top: 30px; padding-bottom: 30px; }
  .screen-layout { flex-direction: column; align-items: center; width: 212px; margin-top: 15px; }
  .header-zone { flex-direction: column; align-items: center; width: 212px; height: 60px; }
  .app-title { font-size: 16px; font-weight: 900; color: #FFFFFF; letter-spacing: 2px; text-align: center; }
  .status-badge { align-items: center; justify-content: center; margin-top: 4px; background-color: rgba(255, 69, 0, 0.1); padding: 2px 10px; border-radius: 20px; }
  .status-text { font-size: 10px; font-weight: bold; color: #FF4500; letter-spacing: 1px; }
  .code-box { width: 170px; height: 95px; background-color: #1C1C1E; border: 2px solid #FF4500; border-radius: 14px; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 20px; }
  .code-title { font-size: 10px; font-weight: bold; color: #8E8E93; letter-spacing: 1px; }
  .code-number { font-size: 38px; font-weight: 900; color: #FFFFFF; margin-top: 2px; letter-spacing: 2px; }
  .info-box { flex-direction: column; align-items: center; width: 212px; margin-bottom: 25px; }
  .hint-text { font-size: 12px; font-weight: bold; color: #E5E5EA; text-align: center; }
  .sub-hint-text { font-size: 10px; color: #8E8E93; text-align: center; margin-top: 2px; }
  .text-card { width: 192px; background-color: #1C1C1E; border-radius: 14px; border: 1px solid #2C2C2E; padding: 14px; margin-bottom: 25px; }
  .main-text { font-size: 14px; color: #FFFFFF; line-height: 22px; font-weight: 500; }
  .btn { width: 180px; height: 42px; border-radius: 12px; font-size: 14px; font-weight: bold; letter-spacing: 1px; }
  .btn-primary { background-color: #FF4500; color: #FFFFFF; }
  .btn-danger { background-color: #48484A; color: #E5E5EA; }
  .footer-credits { flex-direction: column; align-items: center; width: 212px; margin-top: auto; }
  .credits-label { font-size: 9px; color: #48484A; letter-spacing: 1px; }
  .credits-name { font-size: 11px; font-weight: 900; color: #FFD700; letter-spacing: 1px; margin-top: 2px; }
</style>

<script>
  import fetch from '@system.fetch'
  import storage from '@system.storage'
  import vibrator from '@system.vibrator'
  
  export default {
    private: {
      hasData: false,
      savedText: '',
      deviceId: 'mb10_77777'
    },
    onCreate() {
      this.loadLocalData();
    },
    loadLocalData() {
      storage.get({
        key: 'saved_clipboard_text',
        success: (data) => {
          if (data && data.trim() !== '') {
            this.savedText = data;
            this.hasData = true;
          }
        }
      });
    },
    checkServerData() {
      if (this.hasData) return;
      
      const s = '/';
      const targetUrl = 'https:' + s + s + 'vacker.dev' + s + 'api' + s + 'paste' + s + this.deviceId;
      
      fetch.fetch({
        url: targetUrl,
        method: 'GET',
        responseType: 'text',
        success: (response) => {
          if (response.code === 200 && response.data && response.data.trim() !== '') {
            this.savedText = response.data;
            this.hasData = true;
            storage.set({ key: 'saved_clipboard_text', value: response.data });
            try { vibrator.vibrate({ mode: 'long' }); } catch(e){}
          } else {
            try { vibrator.vibrate({ mode: 'short' }); } catch(e){}
          }
        },
        fail: () => {
          try { vibrator.vibrate({ mode: 'short' }); } catch(e){}
        }
      });
    },
    clearData() {
      this.savedText = '';
      this.hasData = false;
      storage.delete({ key: 'saved_clipboard_text' });
      try { vibrator.vibrate({ mode: 'short' }); } catch(e){}
    }
  }
</script>
