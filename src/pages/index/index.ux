<script>
  import fetch from '@system.fetch'
  import storage from '@system.storage'
  import vibrator from '@system.vibrator'
  
  export default {
    private: {
      hasData: false,
      savedText: '',
      deviceId: '',
      qrCodeUrl: ''
    },
    onCreate() {
      this.loadLocalData();
    },
    generateSecureToken() {
      const rNum = Math.random() * 900000;
      const rand = Math.floor(100000 + rNum);
      const ts = Date.now().toString().slice(-6);
      this.deviceId = 'mb10_clip_' + ts + '_' + rand;
      
      const s = '/';
      // НАСТРОЙКА: Укажите здесь ваши реальные данные репозитория
      const username = 'dimakorol-de'; 
      const repo = 'mi-band-10-app-notes'; // или имя вашего репо с загрузчиком
      
      // Сборка ссылки на ваш веб-интерфейс GitHub Pages
      const userWebUrl = 'https:' + s + s + username + '.github.io' + s + repo + s + '?token=' + this.deviceId;
      
      // ИСПРАВЛЕНО: Удалены лишние символы "://", ломавшие работу API QRServer
      const qrHost = 'https:' + s + s + 'api.qrserver.com';
      const qrPath = s + 'v1' + s + 'create-qr-code?size=128x128&data=';
      this.qrCodeUrl = qrHost + qrPath + encodeURIComponent(userWebUrl);
    },
    loadLocalData() {
      storage.get({
        key: 'saved_clipboard_text',
        success: (data) => {
          if (data && data.trim() !== '') {
            this.savedText = data;
            this.hasData = true;
          } else {
            this.generateSecureToken();
          }
        },
        fail: () => {
          this.generateSecureToken();
        }
      });
    },
    checkServerData() {
      if (this.hasData) return;
      
      const s = '/';
      const targetUrl = 'https:' + s + s + 'keyvalue.xyz' + s + 'v1' + s + this.deviceId + s + 'note';
      
      fetch.fetch({
        url: targetUrl,
        method: 'GET',
        responseType: 'text',
        success: (response) => {
          if (response.code === 200 && response.data && response.data.trim() !== '') {
            this.savedText = response.data;
            this.hasData = true;
            storage.set({ key: 'saved_clipboard_text', value: response.data });
            try { vibrator.vibrate({ mode: 'long' }); } catch(e){}
          } else {
            try { vibrator.vibrate({ mode: 'short' }); } catch(e){}
          }
        },
        fail: () => {
          try { vibrator.vibrate({ mode: 'short' }); } catch(e){}
        }
      });
    },
    clearData() {
      this.savedText = '';
      this.hasData = false;
      storage.delete({ key: 'saved_clipboard_text' });
      try { vibrator.vibrate({ mode: 'short' }); } catch(e){}
      this.generateSecureToken();
    }
  }
</script>
