<template>
  <div class="container">
    <div if="{{ !hasData }}" class="screen-layout">
      <div class="header-zone">
        <text class="app-title">CLIPBOARD</text>
        <div class="status-badge">
          <text class="status-text">ECO MODE</text>
        </div>
      </div>
      <div class="qr-container">
        <image class="qr-element" src="{{ qrCodeUrl }}"></image>
      </div>
      <div class="info-box">
        <text class="hint-text">Отправьте текст с iPhone</text>
        <text class="sub-hint-text">и нажмите кнопку ниже для загрузки</text>
      </div>
      <input type="button" class="btn btn-primary" value="Получить текст" onclick="checkServerData" />
    </div>
    <div if="{{ hasData }}" class="screen-layout">
      <div class="header-zone">
        <text class="app-title">ЗАМЕТКА</text>
        <text class="char-count">OFFLINE MEMORY</text>
      </div>
      <div class="text-card">
        <text class="main-text">{{ savedText }}</text>
      </div>
      <input type="button" class="btn btn-danger" value="Очистить буфер" onclick="clearData" />
    </div>
    <div class="footer-credits">
      <text class="credits-label">SYSTEM LOG BY</text>
      <text class="credits-name">A. SOLDATOV</text>
    </div>
  </div>
</template>

<style>
  .container { flex-direction: column; align-items: center; width: 212px; padding-top: 32px; padding-bottom: 32px; background-color: #000000; }
  .screen-layout { flex-direction: column; align-items: center; width: 212px; }
  .header-zone { flex-direction: column; align-items: center; margin-bottom: 20px; width: 190px; }
  .app-title { font-size: 16px; font-weight: 900; color: #FFFFFF; letter-spacing: 2px; text-align: center; }
  .status-badge { align-items: center; justify-content: center; margin-top: 4px; background-color: rgba(255, 69, 0, 0.1); padding: 2px 10px; border-radius: 20px; }
  .status-text { font-size: 10px; font-weight: bold; color: #FF4500; letter-spacing: 1px; }
  .char-count { font-size: 10px; font-weight: bold; color: #8E8E93; letter-spacing: 1px; margin-top: 4px; }
  .qr-container { width: 144px; height: 144px; background-color: #FFFFFF; border-radius: 16px; justify-content: center; align-items: center; padding: 8px; margin-bottom: 20px; box-shadow: 0px 4px 20px rgba(255, 69, 0, 0.2); }
  .qr-element { width: 128px; height: 128px; }
  .info-box { flex-direction: column; align-items: center; margin-bottom: 20px; width: 190px; }
  .hint-text { font-size: 12px; font-weight: bold; color: #E5E5EA; text-align: center; }
  .sub-hint-text { font-size: 10px; color: #8E8E93; text-align: center; margin-top: 2px; }
  .text-card { width: 192px; background-color: #1C1C1E; border-radius: 14px; border: 1px solid #2C2C2E; padding: 14px; margin-bottom: 25px; }
  .main-text { font-size: 14px; color: #FFFFFF; line-height: 22px; font-weight: 500; }
  .btn { width: 180px; height: 42px; border-radius: 12px; font-size: 14px; font-weight: bold; letter-spacing: 1px; }
  .btn-primary { background-color: #FF4500; color: #FFFFFF; }
  .btn-danger { background-color: #48484A; color: #E5E5EA; }
  .footer-credits { flex-direction: column; align-items: center; margin-top: auto; width: 180px; padding-top: 20px; }
  .credits-label { font-size: 9px; color: #48484A; letter-spacing: 1px; }
  .credits-name { font-size: 11px; font-weight: 900; color: #FFD700; letter-spacing: 1px; margin-top: 2px; }
</style>

<script>
  import fetch from '@system.fetch'
  import storage from '@system.storage'
  import vibrator from '@system.vibrator'
  
  export default {
    private: {
      hasData: false,
      savedText: '',
      deviceId: '',
      qrCodeUrl: ''
    },
    onCreate() {
      this.loadLocalData();
    },
    generateSecureToken() {
      const rNum = Math.random() * 900000;
      const rand = Math.floor(100000 + rNum);
      const ts = Date.now().toString().slice(-6);
      this.deviceId = 'mb10_clip_' + ts + '_' + rand;
      
      const p1 = 'https://key';
      const p2 = 'value.xyz/vie';
      const p3 = 'wer?key=';
      const userWebUrl = p1 + p2 + p3 + this.deviceId;
      
      const q1 = 'https://api.qr';
      const q2 = '://server.com';
      const q3 = 'ate-qr-code/?si';
      const q4 = 'ze=128x128&data=';
      const qrBase = q1 + q2 + q3 + q4;
      
      this.qrCodeUrl = qrBase + encodeURIComponent(userWebUrl);
    },
    loadLocalData() {
      storage.get({
        key: 'saved_clipboard_text',
        success: (data) => {
          if (data && data.trim() !== '') {
            this.savedText = data;
            this.hasData = true;
          } else {
            this.generateSecureToken();
          }
        },
        fail: () => {
          this.generateSecureToken();
        }
      });
    },
    checkServerData() {
      if (this.hasData) return;
      
      const targetUrl = 'https://keyvalue.xyz' + this.deviceId;
      
      fetch.fetch({
        url: targetUrl,
        method: 'GET',
        responseType: 'text',
        success: (response) => {
          if (response.code === 200 && response.data && response.data.trim() !== '') {
            this.savedText = response.data;
            this.hasData = true;
            storage.set({ key: 'saved_clipboard_text', value: response.data });
            try { vibrator.vibrate({ mode: 'long' }); } catch(e){}
          } else {
            try { vibrator.vibrate({ mode: 'short' }); } catch(e){}
          }
        },
        fail: () => {
          try { vibrator.vibrate({ mode: 'short' }); } catch(e){}
        }
      });
    },
    clearData() {
      this.savedText = '';
      this.hasData = false;
      storage.delete({ key: 'saved_clipboard_text' });
      try { vibrator.vibrate({ mode: 'short' }); } catch(e){}
      this.generateSecureToken();
    }
  }
</script>
