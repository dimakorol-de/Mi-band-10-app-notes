<template>
  <div class="container">
    
    <!-- ВЕРХНЯЯ ПАНЕЛЬ (ГОРЯТ ВСЕГДА) -->
    <div class="header-zone">
      <text class="app-title">CLIPBOARD</text>
      <div class="status-badge">
        <text class="status-text">{{ hasData ? 'OFFLINE MEMORY' : 'ECO MODE' }}</text>
      </div>
    </div>

    <!-- ЭКРАН ОЖИДАНИЯ (Показываем, если данных нет) -->
    <div if="{{ !hasData }}" class="screen-layout">
      <div class="qr-container">
        <image class="qr-element" src="{{ qrCodeUrl }}"></image>
      </div>
      
      <div class="info-box">
        <text class="hint-text">Сканируйте через iPhone</text>
        <text class="sub-hint-text">Затем нажмите кнопку ниже</text>
      </div>
      
      <input type="button" class="btn btn-primary" value="Получить текст" onclick="checkServerData" />
    </div>

    <!-- ЭКРАН ТЕКСТА (Показываем, когда данные прилетели) -->
    <div if="{{ hasData }}" class="screen-layout">
      <div class="text-card">
        <text class="main-text">{{ savedText }}</text>
      </div>
      
      <input type="button" class="btn btn-danger" value="Очистить буфер" onclick="clearData" />
    </div>

    <!-- СИСТЕМНЫЙ ФУТЕР -->
    <div class="footer-credits">
      <text class="credits-label">SYSTEM LOG BY</text>
      <text class="credits-name">A. SOLDATOV</text>
    </div>

  </div>
</template>

<style>
  .container { 
    flex-direction: column; 
    align-items: center; 
    width: 212px; 
    height: 490px;
    background-color: #000000; 
    padding-top: 30px; 
    padding-bottom: 30px; 
  }
  .screen-layout { 
    flex-direction: column; 
    align-items: center; 
    width: 212px; 
    margin-top: 10px;
  }
  .header-zone { 
    flex-direction: column; 
    align-items: center; 
    width: 212px; 
    height: 60px;
  }
  .app-title { 
    font-size: 16px; 
    font-weight: 900; 
    color: #FFFFFF; 
    letter-spacing: 2px; 
    text-align: center; 
  }
  .status-badge { 
    align-items: center; 
    justify-content: center; 
    margin-top: 4px; 
    background-color: rgba(255, 69, 0, 0.1); 
    padding: 2px 10px; 
    border-radius: 20px; 
  }
  .status-text { 
    font-size: 10px; 
    font-weight: bold; 
    color: #FF4500; 
    letter-spacing: 1px; 
  }
  .qr-container { 
    width: 144px; 
    height: 144px; 
    background-color: #FFFFFF; 
    border-radius: 16px; 
    justify-content: center; 
    align-items: center; 
    margin-bottom: 15px; 
  }
  .qr-element { 
    width: 128px; 
    height: 128px; 
  }
  .info-box { 
    flex-direction: column; 
    align-items: center; 
    width: 212px; 
    margin-bottom: 15px;
  }
  .hint-text { 
    font-size: 12px; 
    font-weight: bold; 
    color: #E5E5EA; 
    text-align: center; 
  }
  .sub-hint-text { 
    font-size: 10px; 
    color: #8E8E93; 
    text-align: center; 
    margin-top: 2px; 
  }
  .text-card { 
    width: 192px; 
    background-color: #1C1C1E; 
    border-radius: 14px; 
    border: 1px solid #2C2C2E; 
    padding: 14px; 
    margin-bottom: 20px; 
  }
  .main-text { 
    font-size: 14px; 
    color: #FFFFFF; 
    line-height: 22px; 
    font-weight: 500; 
  }
  .btn { 
    width: 180px; 
    height: 42px; 
    border-radius: 12px; 
    font-size: 14px; 
    font-weight: bold; 
    letter-spacing: 1px; 
  }
  .btn-primary { 
    background-color: #FF4500; 
    color: #FFFFFF; 
  }
  .btn-danger { 
    background-color: #48484A; 
    color: #E5E5EA; 
  }
  .footer-credits { 
    flex-direction: column; 
    align-items: center; 
    width: 212px; 
    margin-top: auto;
  }
  .credits-label { 
    font-size: 9px; 
    color: #48484A; 
    letter-spacing: 1px; 
  }
  .credits-name { 
    font-size: 11px; 
    font-weight: 900; 
    color: #FFD700; 
    letter-spacing: 1px; 
    margin-top: 2px; 
  }
</style>

<script>
  import fetch from '@system.fetch'
  import storage from '@system.storage'
  import vibrator from '@system.vibrator'
  
  export default {
    private: {
      hasData: false,
      savedText: '',
      deviceId: 'mb10_init_device',
      qrCodeUrl: ''
    },
    onCreate() {
      this.generateSecureToken();
      this.loadLocalData();
    },
    generateSecureToken() {
      const rand = Math.floor(100000 + Math.random() * 900000);
      const ts = Date.now().toString().slice(-6);
      this.deviceId = 'mb10_clip_' + ts + '_' + rand;
      
      const s = '/';
      const username = 'dimakorol-de'; 
      const repo = 'mi-band-10-app-notes';
      
      const userWebUrl = 'https:' + s + s + username + '.github.io' + s + repo + s + '?token=' + this.deviceId;
      
      // ИСПРАВЛЕНО: Убрано лишнее двоеточие со слэшами, добавлен поддомен api.
      const qrHost = 'https:' + s + s + 'api.qrserver.com';
      const qrPath = s + 'v1' + s + 'create-qr-code?size=128x128&data=' + encodeURIComponent(userWebUrl);
      this.qrCodeUrl = qrHost + qrPath;
    },
    loadLocalData() {
      storage.get({
        key: 'saved_clipboard_text',
        success: (data) => {
          if (data && data.trim() !== '') {
            this.savedText = data;
            this.hasData = true;
          }
        }
      });
    },
    checkServerData() {
      if (this.hasData) return;
      
      const s = '/';
      const targetUrl = 'https:' + s + s + 'keyvalue.xyz' + s + 'v1' + s + this.deviceId + s + 'note';
      
      fetch.fetch({
        url: targetUrl,
        method: 'GET',
        responseType: 'text',
        success: (response) => {
          if (response.code === 200 && response.data && response.data.trim() !== '') {
            this.savedText = response.data;
            this.hasData = true;
            storage.set({ key: 'saved_clipboard_text', value: response.data });
            try { vibrator.vibrate({ mode: 'long' }); } catch(e){}
          } else {
            try { vibrator.vibrate({ mode: 'short' }); } catch(e){}
          }
        },
        fail: () => {
          try { vibrator.vibrate({ mode: 'short' }); } catch(e){}
        }
      });
    },
    clearData() {
      this.savedText = '';
      this.hasData = false;
      storage.delete({ key: 'saved_clipboard_text' });
      try { vibrator.vibrate({ mode: 'short' }); } catch(e){}
      this.generateSecureToken();
    }
  }
</script>
